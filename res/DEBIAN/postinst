#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/rd_client/rd_client /usr/bin/rd_client

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/rd_client.service ]; then
			rm -f /etc/systemd/system/rd_client.service /usr/lib/systemd/system/rd_client.service /usr/lib/systemd/user/rd_client.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/rd_client/files/systemd/rd_client.service /usr/lib/systemd/system/rd_client.service
		# try fix error in Ubuntu 18.04
		# Failed to reload rd_client.service: Unit rd_client.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/rd_client.service:10: Executable path is not absolute: pkill -f "rd_client --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/rd_client.service
		fi
		systemctl daemon-reload
		systemctl enable rd_client
		systemctl start rd_client
	fi
fi
